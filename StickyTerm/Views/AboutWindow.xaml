<Window x:Class="StickyTerm.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About StickyTerm"
        Background="{DynamicResource PanelBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <!-- App Icon -->
        <Image Source="pack://application:,,,/Resources/app.ico"
               Width="64" Height="64" Margin="0,0,0,16"
               HorizontalAlignment="Center"/>

        <!-- Title + Version -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="StickyTerm" FontWeight="Bold" FontSize="22"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding Version, StringFormat=' v{0}'}"
                       FontSize="22" Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Tagline -->
        <TextBlock Text="Serial terminal with sticky COM port assignments"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16"
                   FontSize="13"/>

        <!-- Links -->
        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Margin="0,0,0,8">
                    <Hyperlink Foreground="{DynamicResource AccentBrush}"
                               NavigateUri="https://battlewithbytes.io/projects/stickyterm"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        battlewithbytes.io/projects/stickyterm
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink Foreground="{DynamicResource AccentBrush}"
                               NavigateUri="https://github.com/ril3y/StickyTerm"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        github.com/ril3y/StickyTerm
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- License -->
        <TextBlock Text="MIT License"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"
                   FontSize="12"/>

        <!-- OK Button -->
        <Button Content="OK" Click="OkButton_Click" IsDefault="True"
                HorizontalAlignment="Center"/>
    </StackPanel>
</Window>

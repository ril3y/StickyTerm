<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#555555"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00FF9D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33FFB5"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00FF9D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C084FC"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44747"/>

    <!-- Control Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2D1B4E"/>
    <SolidColorBrush x:Key="DataGridAlternateBrush" Color="#111111"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#111111"/>

    <!-- Terminal Colors -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="TerminalTimestampBrush" Color="#666666"/>
    <SolidColorBrush x:Key="LedOnBrush" Color="#00FF9D"/>
    <SolidColorBrush x:Key="LedOffBrush" Color="#333333"/>

    <!-- ScrollBar Colors -->
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#555555"/>

</ResourceDictionary>

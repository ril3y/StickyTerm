<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#757575"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9E9E9E"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00CC7D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#00A866"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00CC7D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9333EA"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>

    <!-- Control Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8D5F5"/>
    <SolidColorBrush x:Key="DataGridAlternateBrush" Color="#FAFAFA"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F0FFF4"/>

    <!-- Terminal Colors -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TerminalTimestampBrush" Color="#666666"/>
    <SolidColorBrush x:Key="LedOnBrush" Color="#00CC7D"/>
    <SolidColorBrush x:Key="LedOffBrush" Color="#D0D0D0"/>

    <!-- ScrollBar Colors -->
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A6A6"/>

</ResourceDictionary>

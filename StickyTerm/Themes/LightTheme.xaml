<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#999999"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00AA68"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#008C55"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00AA68"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFFFFF"/>

    <!-- Control Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#BEBEBE"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DDD0EE"/>
    <SolidColorBrush x:Key="DataGridAlternateBrush" Color="#E4E4E4"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#DEDEDE"/>

    <!-- Terminal Colors -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TerminalTimestampBrush" Color="#777777"/>
    <SolidColorBrush x:Key="LedOnBrush" Color="#00AA68"/>
    <SolidColorBrush x:Key="LedOffBrush" Color="#C0C0C0"/>

    <!-- ScrollBar Colors -->
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#909090"/>

</ResourceDictionary>

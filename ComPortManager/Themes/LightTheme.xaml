<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#757575"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9E9E9E"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>

    <!-- Control Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#BBDEFB"/>
    <SolidColorBrush x:Key="DataGridAlternateBrush" Color="#FAFAFA"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#E3F2FD"/>

</ResourceDictionary>

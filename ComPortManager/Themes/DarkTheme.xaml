<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6D6D6D"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0D7ACC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C97EA"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6A9955"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#DCDCAA"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44747"/>

    <!-- Control Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#505050"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#264F78"/>
    <SolidColorBrush x:Key="DataGridAlternateBrush" Color="#2D2D30"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC"/>

</ResourceDictionary>
